{
  // Solo archivos estáticos: sin script (main) ni binding ASSETS. Se publica la carpeta dist/ que genera «npm run publish».
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portafolio",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
